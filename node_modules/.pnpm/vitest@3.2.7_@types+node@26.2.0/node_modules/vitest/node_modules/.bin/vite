#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*) basedir=`cygpath -w "$basedir"`;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/workspace/node_modules/.pnpm/vite@7.3.6_@types+node@26.2.0/node_modules/vite/bin/node_modules:/workspace/node_modules/.pnpm/vite@7.3.6_@types+node@26.2.0/node_modules/vite/node_modules:/workspace/node_modules/.pnpm/vite@7.3.6_@types+node@26.2.0/node_modules:/workspace/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/workspace/node_modules/.pnpm/vite@7.3.6_@types+node@26.2.0/node_modules/vite/bin/node_modules:/workspace/node_modules/.pnpm/vite@7.3.6_@types+node@26.2.0/node_modules/vite/node_modules:/workspace/node_modules/.pnpm/vite@7.3.6_@types+node@26.2.0/node_modules:/workspace/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../../vite@7.3.6_@types+node@26.2.0/node_modules/vite/bin/vite.js" "$@"
else
  exec node  "$basedir/../../../../../vite@7.3.6_@types+node@26.2.0/node_modules/vite/bin/vite.js" "$@"
fi
