# Rust
target/
**/target/

# Node
node_modules/
dist/
build/

# Tauri
src-tauri/target/
src-tauri/gen/
# Bundled mpv runtime for macOS/Windows (build script populates this; the
# large dylib/dll binaries are never committed). License/attribution texts in
# mpv_runtime/licenses/ ARE committed because LGPL distribution requires them.
src-tauri/mpv_runtime/*
!src-tauri/mpv_runtime/.gitkeep
!src-tauri/mpv_runtime/licenses/
!src-tauri/mpv_runtime/licenses/*
!src-tauri/mpv_runtime/licenses/NOTICE.txt

# Environment
.env
.env.*
!.env.example

# macOS
.DS_Store
._*

# IDE
.vscode/
.idea/

# Logs
*.log

# Temporary
tmp/
temp/

# Runtime data
*.db
*.sqlite
*.sqlite3

# Movie/media files
*.mp4
*.mkv
*.mov
*.avi

# ...except the committed test fixture. It is small (52 KB), synthetic, has no
# audio, and MUST be present in a clean checkout: the real_* playback tests
# require it and used to silently pass when a /tmp copy was absent. Committing
# it is what lets those tests execute in CI instead of reporting a false green.
# Regenerate with scripts/make-test-media-macos.sh (see BATCH5_REPORT.md).
!src-tauri/tests/fixtures/
!src-tauri/tests/fixtures/*.mp4

# Build artifacts
*.dmg
*.app

# Package stores
.pnpm-store/

# Local editor/agent scratch directories (never commit)
.freebuff/
.kilo/
.workbuddy-ai/