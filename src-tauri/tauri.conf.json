{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Move Party",
  "version": "0.1.0",
  "identifier": "app.moveparty.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Move Party",
        "width": 1024,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Entertainment",
    "shortDescription": "Watch together and stay synchronized.",
    "longDescription": "Private two-person desktop cinema app for synchronized local media and provider playback."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "moveparty"
        ]
      }
    }
  }
}
