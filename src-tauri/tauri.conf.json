{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Movie Party",
  "version": "0.9.6",
  "identifier": "app.movieparty.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Movie Party",
        "width": 1024,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#05050B",
        "center": true
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://image.tmdb.org; media-src 'self' blob: mediastream:; connect-src 'self' ipc: http://ipc.localhost https://api.themoviedb.org; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Entertainment",
    "shortDescription": "Watch together and stay synchronized.",
    "longDescription": "Private two-person desktop cinema app for synchronized local media and provider playback.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "mpv_runtime/"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "movieparty"
        ]
      }
    }
  }
}
