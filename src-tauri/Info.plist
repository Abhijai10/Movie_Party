<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>CFBundleURLTypes</key>
    <array>
      <dict>
        <key>CFBundleTypeRole</key>
        <string>Viewer</string>
        <key>CFBundleURLName</key>
        <string>app.movieparty.desktop.invite</string>
        <key>CFBundleURLSchemes</key>
        <array>
          <string>movieparty</string>
        </array>
      </dict>
    </array>
    <!-- getUserMedia() for the WebRTC call feature: macOS WKWebView
         denies camera/microphone without these usage-description keys
         (surfaces as MP-CALL-011 NotAllowedError). Tauri merges this
         file into the generated app bundle's Info.plist at build time. -->
    <key>NSCameraUsageDescription</key>
    <string>Movie Party uses the camera for the optional video call with your movie partner.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Movie Party uses the microphone for the call with your movie partner.</string>
  </dict>
</plist>
